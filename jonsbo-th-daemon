"""Background service: sends the chosen temperature to the Jonsbo TH display and publishes status for the GUI."""

import argparse
import os
import signal
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import jonsbo_th_common as jt  # noqa: E402


def log(msg):
    print(msg, file=sys.stderr, flush=True)


class DockBadge:
    """Shows the temperature as a badge on the app's dock icon (Ubuntu Dock / Dash to Dock,
    KDE, Plank...) via the com.canonical.Unity.LauncherEntry D-Bus signal.

    Best effort: if there is no session bus (e.g. running from boot with lingering) or
    PyGObject is missing, it silently does nothing and retries later.
    """

    PATH = "/io/github/jonsbo_th/LauncherEntry"
    RESEND_S = 10  # re-send periodically so a restarted dock picks the value up again
    RETRY_S = 30

    def __init__(self):
        self.conn = None
        self.next_try = 0.0
        self.sent = None
        self.sent_at = 0.0

    def _connect(self):
        if self.conn is not None or time.monotonic() < self.next_try:
            return self.conn
        self.next_try = time.monotonic() + self.RETRY_S
        try:
            from gi.repository import Gio
            self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except Exception:
            self.conn = None
        return self.conn

    def update(self, shown):
        """shown: integer to display, or None to hide the badge."""
        now = time.monotonic()
        if shown == self.sent and now - self.sent_at < self.RESEND_S:
            return
        conn = self._connect()
        if conn is None:
            return
        try:
            from gi.repository import GLib
            props = {"count-visible": GLib.Variant("b", shown is not None)}
            if shown is not None:
                props["count"] = GLib.Variant("x", shown)
            conn.emit_signal(None, self.PATH, "com.canonical.Unity.LauncherEntry", "Update",
                             GLib.Variant("(sa{sv})", ("application://" + jt.DESKTOP_ID, props)))
            conn.flush_sync(None)
            self.sent, self.sent_at = shown, now
        except Exception:
            self.conn = None  # bus went away; reconnect later


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--test", type=int, metavar="N", help="send N once to the display and exit")
    ap.add_argument("--device", help="hidraw node (default: auto-detect 5131:2007)")
    args = ap.parse_args()

    running = True

    def stop(*_):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    if args.test is not None:
        path = args.device or jt.find_hidraw()
        if not path:
            log("Display 5131:2007 not found")
            return 1
        try:
            fd = os.open(path, os.O_WRONLY)
            try:
                os.write(fd, jt.make_packet(args.test))
            finally:
                os.close(fd)
        except OSError as e:
            log(f"Cannot write to {path}: {e.strerror or e}")
            if isinstance(e, PermissionError):
                log("Hint: replug the cooler's USB cable or log out and back in so the udev rule applies.")
            return 1
        log(f"Sent {args.test} to {path}")
        return 0

    config, cfg_mtime = jt.load_config(), jt.config_mtime()
    sensors = jt.list_sensors()
    sensors_at = time.monotonic()
    fd = dev_path = None
    error = None
    badge = DockBadge()
    last_logged = None

    while running:
        # Pick up GUI changes.
        m = jt.config_mtime()
        if m != cfg_mtime:
            config, cfg_mtime = jt.load_config(), m
            log(f"Config reloaded: mode={config['mode']} sensors={config['sensors']} offset={config['offset']}")
        # Re-scan sensors now and then (drivers can load late after boot/resume).
        if time.monotonic() - sensors_at > 30:
            sensors, sensors_at = jt.list_sensors(), time.monotonic()

        value, readings = jt.compute(config, sensors)
        shown = jt.display_digits(value) if value is not None else None

        try:
            if fd is None:
                dev_path = args.device or jt.find_hidraw()
                if not dev_path:
                    raise OSError("Display not found (USB 5131:2007)")
                fd = os.open(dev_path, os.O_WRONLY)
                log(f"Opened display at {dev_path}")
            if value is not None:
                os.write(fd, jt.make_packet(value))
            error = None if value is not None else "Selected sensors could not be read"
        except OSError as e:
            error = e.strerror or str(e)
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass
            fd = dev_path = None

        if error != last_logged:
            log(f"Error: {error}" if error else "OK")
            last_logged = error

        try:
            jt.write_status({
                "value": value, "shown": shown, "mode": config["mode"],
                "device": dev_path, "error": error, "readings": readings,
            })
        except OSError:
            pass

        badge.update(shown if (config["dock_badge"] and fd is not None) else None)

        time.sleep(config["interval"] if fd is not None else 2.0)

    if fd is not None:
        os.close(fd)
    badge.sent_at = 0
    badge.update(None)
    try:
        os.unlink(jt.STATUS_PATH)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
