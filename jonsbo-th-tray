"""Top-bar (tray) icon for the Jonsbo TH display.

Speaks the StatusNotifierItem + com.canonical.dbusmenu D-Bus protocols directly (no
AppIndicator library needed). On Ubuntu it shows up through the "Ubuntu AppIndicators"
GNOME extension, next to icons like Steam's, with the current temperature as a label.
"""

import os
import signal
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import jonsbo_th_common as jt  # noqa: E402

from gi.repository import Gio, GLib  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
GUI = os.path.join(HERE, "jonsbo-th-gui")
ICON_NAME = "jonsbo-th-tray-symbolic"
ICON_DIR = os.path.join(HERE, "icons")  # contains jonsbo-th-tray-symbolic.svg
MODE_LABELS = {"max": "Cao nhất", "avg": "Trung bình", "min": "Thấp nhất"}
REFRESH_MS = 1000

SNI_PATH = "/StatusNotifierItem"
MENU_PATH = "/MenuBar"

INTROSPECTION = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="WindowId" type="i" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconThemePath" type="s" access="read"/>
    <property name="IconPixmap" type="a(iiay)" access="read"/>
    <property name="OverlayIconName" type="s" access="read"/>
    <property name="AttentionIconName" type="s" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <property name="XAyatanaLabel" type="s" access="read"/>
    <property name="XAyatanaLabelGuide" type="s" access="read"/>
    <method name="ContextMenu"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="Activate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="SecondaryActivate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="Scroll"><arg name="delta" type="i" direction="in"/><arg name="orientation" type="s" direction="in"/></method>
    <signal name="NewTitle"/>
    <signal name="NewIcon"/>
    <signal name="NewToolTip"/>
    <signal name="NewStatus"><arg name="status" type="s"/></signal>
    <signal name="XAyatanaNewLabel"><arg name="label" type="s"/><arg name="guide" type="s"/></signal>
  </interface>
  <interface name="com.canonical.dbusmenu">
    <property name="Version" type="u" access="read"/>
    <property name="TextDirection" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconThemePath" type="as" access="read"/>
    <method name="GetLayout">
      <arg type="i" name="parentId" direction="in"/>
      <arg type="i" name="recursionDepth" direction="in"/>
      <arg type="as" name="propertyNames" direction="in"/>
      <arg type="u" name="revision" direction="out"/>
      <arg type="(ia{sv}av)" name="layout" direction="out"/>
    </method>
    <method name="GetGroupProperties">
      <arg type="ai" name="ids" direction="in"/>
      <arg type="as" name="propertyNames" direction="in"/>
      <arg type="a(ia{sv})" name="properties" direction="out"/>
    </method>
    <method name="GetProperty">
      <arg type="i" name="id" direction="in"/>
      <arg type="s" name="name" direction="in"/>
      <arg type="v" name="value" direction="out"/>
    </method>
    <method name="Event">
      <arg type="i" name="id" direction="in"/>
      <arg type="s" name="eventId" direction="in"/>
      <arg type="v" name="data" direction="in"/>
      <arg type="u" name="timestamp" direction="in"/>
    </method>
    <method name="EventGroup">
      <arg type="a(isvu)" name="events" direction="in"/>
      <arg type="ai" name="idErrors" direction="out"/>
    </method>
    <method name="AboutToShow">
      <arg type="i" name="id" direction="in"/>
      <arg type="b" name="needUpdate" direction="out"/>
    </method>
    <method name="AboutToShowGroup">
      <arg type="ai" name="ids" direction="in"/>
      <arg type="ai" name="updatesNeeded" direction="out"/>
      <arg type="ai" name="idErrors" direction="out"/>
    </method>
    <signal name="ItemsPropertiesUpdated">
      <arg type="a(ia{sv})" name="updatedProps"/>
      <arg type="a(ias)" name="removedProps"/>
    </signal>
    <signal name="LayoutUpdated">
      <arg type="u" name="revision"/>
      <arg type="i" name="parent"/>
    </signal>
    <signal name="ItemActivationRequested">
      <arg type="i" name="id"/>
      <arg type="u" name="timestamp"/>
    </signal>
  </interface>
</node>
"""

# Menu item ids
ID_HEADER, ID_OPEN, ID_LABEL, ID_HIDE = 1, 2, 3, 4
ID_MODE = {"max": 10, "avg": 11, "min": 12}
SEP_IDS = (90, 91, 92)


class Tray:
    def __init__(self, loop):
        self.loop = loop
        self.conn = None
        self.revision = 1
        self.config = jt.load_config()
        self.cfg_mtime = jt.config_mtime()
        self.sensors = jt.list_sensors()
        self.shown = None
        self.state_text = ""
        self.label = ""
        self.bus_name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
        self.node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)

    # ------------------------------------------------------------ D-Bus setup
    def start(self):
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        register = getattr(self.conn, "register_object_with_closures2", None) or self.conn.register_object
        register(SNI_PATH, self.node.lookup_interface("org.kde.StatusNotifierItem"),
                 self._sni_call, self._sni_prop, None)
        register(MENU_PATH, self.node.lookup_interface("com.canonical.dbusmenu"),
                 self._menu_call, self._menu_prop, None)
        Gio.bus_own_name_on_connection(self.conn, self.bus_name, Gio.BusNameOwnerFlags.NONE, None, None)
        # (Re-)register whenever the panel's watcher appears, e.g. after GNOME Shell restarts.
        Gio.bus_watch_name_on_connection(self.conn, "org.kde.StatusNotifierWatcher",
                                         Gio.BusNameWatcherFlags.NONE, self._watcher_up, self._watcher_down)
        self._refresh()
        GLib.timeout_add(REFRESH_MS, self._refresh)

    def _watcher_up(self, conn, _name, _owner):
        conn.call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher",
                  "RegisterStatusNotifierItem", GLib.Variant("(s)", (self.bus_name,)),
                  None, Gio.DBusCallFlags.NONE, -1, None, None)
        print("Registered with StatusNotifierWatcher", file=sys.stderr, flush=True)

    def _watcher_down(self, *_):
        print("StatusNotifierWatcher not available (is the Ubuntu AppIndicators extension enabled?)",
              file=sys.stderr, flush=True)

    def _emit(self, path, iface, name, sig=None, args=None):
        self.conn.emit_signal(None, path, iface, name, GLib.Variant(sig, args) if sig else None)

    # ------------------------------------------------------------ StatusNotifierItem
    def _sni_prop(self, _conn, _sender, _path, _iface, prop):
        tip = f"Jonsbo TH · {self.state_text}"
        return {
            "Category": GLib.Variant("s", "Hardware"),
            "Id": GLib.Variant("s", "jonsbo-th"),
            "Title": GLib.Variant("s", "Jonsbo TH"),
            "Status": GLib.Variant("s", "Active"),
            "WindowId": GLib.Variant("i", 0),
            "IconName": GLib.Variant("s", ICON_NAME),
            "IconThemePath": GLib.Variant("s", ICON_DIR),
            "IconPixmap": GLib.Variant("a(iiay)", []),
            "OverlayIconName": GLib.Variant("s", ""),
            "AttentionIconName": GLib.Variant("s", ""),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", (ICON_NAME, [], "Jonsbo TH", tip)),
            "ItemIsMenu": GLib.Variant("b", True),
            "Menu": GLib.Variant("o", MENU_PATH),
            "XAyatanaLabel": GLib.Variant("s", self.label),
            "XAyatanaLabelGuide": GLib.Variant("s", "88°C"),
        }.get(prop)

    def _sni_call(self, _conn, _sender, _path, _iface, method, _params, invocation):
        if method in ("Activate", "SecondaryActivate"):
            self._open_gui()
        invocation.return_value(None)

    # ------------------------------------------------------------ dbusmenu
    def _items(self):
        mode = self.config["mode"]
        items = [
            (ID_HEADER, {"label": self.state_text or "Jonsbo TH", "enabled": False}),
            (SEP_IDS[0], {"type": "separator"}),
            (ID_OPEN, {"label": "Mở Jonsbo TH"}),
            (SEP_IDS[1], {"type": "separator"}),
        ]
        for m in jt.MODES:
            items.append((ID_MODE[m], {"label": MODE_LABELS[m], "toggle-type": "radio",
                                       "toggle-state": 1 if m == mode else 0}))
        items += [
            (SEP_IDS[2], {"type": "separator"}),
            (ID_LABEL, {"label": "Hiện nhiệt độ cạnh biểu tượng", "toggle-type": "checkmark",
                        "toggle-state": 1 if self.config["tray_label"] else 0}),
            (ID_HIDE, {"label": "Ẩn biểu tượng"}),
        ]
        return items

    @staticmethod
    def _props_variant(props):
        out = {}
        for k, v in props.items():
            if isinstance(v, bool):
                out[k] = GLib.Variant("b", v)
            elif isinstance(v, int):
                out[k] = GLib.Variant("i", v)
            else:
                out[k] = GLib.Variant("s", v)
        return out

    def _layout(self):
        children = [GLib.Variant("(ia{sv}av)", (i, self._props_variant(p), [])) for i, p in self._items()]
        root = (0, {"children-display": GLib.Variant("s", "submenu")}, children)
        return GLib.Variant("(u(ia{sv}av))", (self.revision, root))

    def _menu_prop(self, _conn, _sender, _path, _iface, prop):
        return {
            "Version": GLib.Variant("u", 3),
            "TextDirection": GLib.Variant("s", "ltr"),
            "Status": GLib.Variant("s", "normal"),
            "IconThemePath": GLib.Variant("as", [ICON_DIR]),
        }.get(prop)

    def _menu_call(self, _conn, _sender, _path, _iface, method, params, invocation):
        items = dict(self._items())
        if method == "GetLayout":
            invocation.return_value(self._layout())
        elif method == "GetGroupProperties":
            ids = params.unpack()[0]
            res = [(i, self._props_variant(items[i])) for i in (ids or items) if i in items]
            invocation.return_value(GLib.Variant("(a(ia{sv}))", (res,)))
        elif method == "GetProperty":
            i, name = params.unpack()
            val = self._props_variant(items.get(i, {})).get(name, GLib.Variant("s", ""))
            invocation.return_value(GLib.Variant("(v)", (val,)))
        elif method == "Event":
            i, event, _data, _ts = params.unpack()
            invocation.return_value(None)
            if event == "clicked":
                GLib.idle_add(self._clicked, i)
        elif method == "EventGroup":
            for i, event, _data, _ts in params.unpack()[0]:
                if event == "clicked":
                    GLib.idle_add(self._clicked, i)
            invocation.return_value(GLib.Variant("(ai)", ([],)))
        elif method == "AboutToShow":
            invocation.return_value(GLib.Variant("(b)", (False,)))
        elif method == "AboutToShowGroup":
            invocation.return_value(GLib.Variant("(aiai)", ([], [])))
        else:
            invocation.return_value(None)

    def _clicked(self, item_id):
        if item_id == ID_OPEN:
            self._open_gui()
        elif item_id == ID_HIDE:
            self.loop.quit()
        elif item_id == ID_LABEL:
            self.config = jt.load_config()
            self.config["tray_label"] = not self.config["tray_label"]
            jt.save_config(self.config)
        else:
            for m, mid in ID_MODE.items():
                if mid == item_id:
                    self.config = jt.load_config()
                    self.config["mode"] = m
                    jt.save_config(self.config)
        self._refresh()
        return False

    def _open_gui(self):
        # The GUI is a single-instance GtkApplication: a second launch just raises the window.
        subprocess.Popen([sys.executable, GUI], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # ------------------------------------------------------------ periodic update
    def _refresh(self):
        m = jt.config_mtime()
        if m != self.cfg_mtime:
            self.config, self.cfg_mtime = jt.load_config(), m

        status = jt.read_status()
        if status is not None and not status.get("error"):
            shown = status.get("shown")
            state = f"{shown}°C · {MODE_LABELS[self.config['mode']]}" if shown is not None else "Không có dữ liệu"
        elif status is not None:
            shown = status.get("shown")
            state = f"Lỗi: {status['error']}"
        else:
            value, _ = jt.compute(self.config, self.sensors)
            shown = jt.display_digits(value) if value is not None else None
            state = "Dịch vụ nền chưa chạy"

        label = f"{shown}°C" if (shown is not None and self.config["tray_label"]) else ""
        if label != self.label:
            self.label = label
            self._emit(SNI_PATH, "org.kde.StatusNotifierItem", "XAyatanaNewLabel", "(ss)", (label, "88°C"))
        if state != self.state_text:
            self.state_text = state
            self._emit(SNI_PATH, "org.kde.StatusNotifierItem", "NewToolTip")
        layout_key = (self.state_text, self.config["mode"], self.config["tray_label"])
        if layout_key != getattr(self, "_layout_key", None):
            self._layout_key = layout_key
            self.revision += 1
            self._emit(MENU_PATH, "com.canonical.dbusmenu", "LayoutUpdated", "(ui)", (self.revision, 0))
        return True


def main():
    loop = GLib.MainLoop()
    try:
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except ImportError:
        signal_add = GLib.unix_signal_add
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal_add(GLib.PRIORITY_DEFAULT, sig, lambda *_: (loop.quit(), False)[1])
    Tray(loop).start()
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
